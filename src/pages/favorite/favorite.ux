<template>
  <div class="page">
    <text class="title">收藏</text>

    <div if="{{ favs.length === 0 }}" class="empty">
      <text class="empty-text">好像没有收藏哦!</text>
    </div>

    <list else class="list">
      <list-item class="cell" type="fav" for="{{ favs }}" onclick="onFav($item)">
        <div class="cell-bg">
          <div class="cell-inner">
            <text class="cell-kana">{{ $item.ruby }}</text>
            <text class="cell-main">{{ $item.main }}</text>
            <text class="cell-meaning">{{ $item.meaning }}</text>
          </div>
        </div>
      </list-item>
    </list>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 100%;
  background-color: #000000;
}
.title {
  margin-top: 56px;
  margin-bottom: 20px;
  font-size: 36px;
  font-weight: bold;
  color: #ffffff;
}
.empty {
  flex: 1;
  width: 100%;
  justify-content: center;
  align-items: center;
}
.empty-text {
  font-size: 28px;
  color: #8e8e93;
}
.list {
  flex: 1;
  width: 466px;
}
.cell {
  width: 466px;
  margin-bottom: 8px;
  padding: 0 40px;
}
.cell-bg {
  flex: 1;
  border-radius: 20px;
  background-color: #1c1c1e;
}
.cell-inner {
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 12px 16px;
}
.cell-kana {
  font-size: 20px;
  color: #ffd60a;
}
.cell-main {
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
  margin-top: 2px;
}
.cell-meaning {
  font-size: 22px;
  color: #c7c7cc;
  margin-top: 4px;
  max-width: 340px;
  text-overflow: ellipsis;
  lines: 1;
}
</style>

<script>
import router from '@system.router'
import { loadFavs } from '../../common/scripts/fav.js'

export default {
  private: {
    favs: []
  },

  onShow() {
    const that = this
    loadFavs(function (arr) {
      // 预计算展示字段，保证 list-item 内部 DOM 结构一致
      const list = []
      for (let i = 0; i < arr.length; i++) {
        const w = arr[i]
        list.push({
          id: w.id,
          ruby: w.kanji ? w.kana : '',
          main: w.kanji ? w.kanji : w.kana,
          meaning: w.meaning,
          unit: w.unit,
          lesson: w.lesson,
          index: w.index
        })
      }
      that.favs = list
    })
  },

  onFav(item) {
    router.push({
      uri: '/pages/word',
      params: { unit: item.unit, lesson: item.lesson, index: item.index, mode: 'fav' }
    })
  }
}
</script>
